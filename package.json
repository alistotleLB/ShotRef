{
  "name": "shotref",
  "version": "1.1.0",
  "description": "ShotRef: simple 3D blocking and camera-move tool that exports reference videos and frames for AI video models",
  "scripts": {
    "build": "node build.mjs",
    "build:debug": "node build.mjs --debug",
    "test": "node test/smoke.cjs",
    "dev": "node build.mjs && echo Open dist/ShotRef.html in Chrome or Edge",
    "desktop": "node build.mjs && electron .",
    "dist:win": "node build.mjs && electron-builder --win",
    "test:desktop": "node test/desktop.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "three": "^0.187.0"
  },
  "private": true,
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "1.65.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.shotref.desktop",
    "productName": "ShotRef",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/ShotRef.html",
      "branding/shotref.ico",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "shotref",
        "name": "ShotRef project",
        "icon": "branding/shotref-project.ico",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "branding/shotref.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ShotRef-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "ShotRef-${version}-portable.exe"
    }
  }
}
